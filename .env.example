# ==============================================================================
# .env.example - F.A.C.A. (Frente de Autenticação e Controle de Acesso)
# ------------------------------------------------------------------------------
# COMO USAR:
#   1. Copie este arquivo:   Copy-Item .env.example .env   (PowerShell)
#                            cp .env.example .env          (bash)
#   2. Ajuste os valores no .env (NUNCA versione o .env real!).
#
# Sem um .env, o docker-compose.yml usa os mesmos valores padrão abaixo.
# ==============================================================================

# ------------------------------------------------------------------------------
# Fuso horário (MySQL + Backend)
# ------------------------------------------------------------------------------
TZ=America/Sao_Paulo

# ------------------------------------------------------------------------------
# MySQL 8.0 (consumidas pela imagem oficial do contêiner "db")
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=faca_root_2026
MYSQL_DATABASE=faca_db
MYSQL_USER=faca_user
MYSQL_PASSWORD=faca_pass_2026

# Porta do MySQL publicada no HOST (altere se já houver um MySQL local na 3306)
DB_PORT_HOST=3307

# ------------------------------------------------------------------------------
# Conexão da aplicação (SQLAlchemy + PyMySQL)
# ------------------------------------------------------------------------------
# ATENÇÃO À DIFERENÇA DE HOSTNAME:
#   - Via Docker Compose  -> DB_HOST=db
#       "db" é o nome do serviço na rede interna faca_network (DNS do Docker).
#       O docker-compose.yml JÁ INJETA DB_HOST/DATABASE_URL com "db" no backend,
#       portanto os valores abaixo valem apenas para execução fora do Docker.
#   - Execução local direta (python main.py / uvicorn no Windows) -> DB_HOST=localhost
#       O backend roda no SO hospedeiro e alcança o MySQL pela porta publicada
#       (DB_PORT_HOST). O nome "db" NÃO resolve fora da rede do Docker.
DB_HOST=localhost
DB_PORT=3307

# String completa do SQLAlchemy (driver pymysql). Exemplos:
#   Docker : mysql+pymysql://faca_user:faca_pass_2026@db:3306/faca_db?charset=utf8mb4
#   Local  : mysql+pymysql://faca_user:faca_pass_2026@localhost:3306/faca_db?charset=utf8mb4
DATABASE_URL=mysql+pymysql://faca_user:faca_pass_2026@localhost:3307/faca_db?charset=utf8mb4

# ------------------------------------------------------------------------------
# API FastAPI / Uvicorn
# ------------------------------------------------------------------------------
# Porta publicada no HOST (o cliente Desktop PyWebView consome http://localhost:<API_PORT>)
API_PORT=8000

# Segredo para assinatura dos tokens JWT (gere um valor aleatório longo!)
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-esta-chave-em-producao
# Validade do token em segundos (28800 = 8 horas, conforme API.md)
JWT_EXPIRATION_SECONDS=28800

# ------------------------------------------------------------------------------
# Motor Biométrico (OpenCV + face_recognition / dlib)
# ------------------------------------------------------------------------------
# Tolerância da distância euclidiana entre encodings faciais (128-d).
#   Menor = mais rigoroso (menos falsos positivos, mais falsos negativos).
#   Padrão da biblioteca: 0.6 | Recomendado para alta segurança: 0.45 ~ 0.5
FACE_TOLERANCE=0.6

# Nº máximo de tentativas de login biométrico falhas antes do bloqueio de segurança
MAX_LOGIN_ATTEMPTS=3
# Duração do bloqueio após exceder as tentativas (minutos)
LOCKOUT_MINUTES=15
